<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <style>
    div {
      display: inline;
    }
  </style>
</head>

<body>
  <h1>Welcome to home page</h1>
  <form action="/submit" method="POST">
    <div>
      <label for="street">Your street: </label>
      <input type="text" name="street" placeholder="Enter your street" required>
    </div>

    <div>
      <label for="pet">Your pet: </label>
      <input type="text" name="pet" placeholder="Enter your pet's name" required>
    </div>

    <div>
      <input type="submit" value="Submit">
    </div>
  </form>
</body>

</html>