<div class="modal fade" id="modal-create-note">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">New note</h5>
        <button class="btn btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form action="" class="form-create-note">
          <label for="title">Title</label>
          <input type="text" name="title" placeholder="Exp. Intro to" required>
        </form>

      </div>
      <div class="modal-footer">
         <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
         <buttn class="btn btn-primary" type="submit" form="form-create-note">Submit</buttn>
      </div>
    </div>
  </div>
</div>